{
  "name": "varbase_heroslider_media",
  "description": "Varbase Media Hero Slider",
  "author": "Vardot",
  "license": "GPL-2.0-or-later",
  "homepage": "https://www.drupal.org/project/varbase_heroslider_media",
  "private": true,
  "engines": {
    "yarn": ">= 4.9.3",
    "node": ">= 20.0"
  },
  "packageManager": "yarn@4.9.3",
  "scripts": {
    "phpcs": "phpcs --standard=./.phpcs.xml .",
    "phpcbf": "phpcbf --standard=./.phpcs.xml .",
    "lint:js": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:css": "stylelint \"**/*.css\"",
    "lint:yaml": "node ./node_modules/eslint/bin/eslint.js --ext .yml .",
    "spellcheck": "cspell lint .",
    "test": "cucumber-js --config cucumber.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports"
  },
  "keywords": [
    "drupal",
    "webpack",
    "varbase",
    "Hero Slider",
    "Media Hero Slider",
    "frontend"
  ],
  "devDependencies": {
    "clean-webpack-plugin": "^4.0.0",
    "copy-webpack-plugin": "~11.0.0",
    "cspell": "^8.16.1",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.3",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jquery": "^1.5.1",
    "eslint-plugin-prettier": "^5.4.0",
    "eslint-plugin-yml": "^1.18.0",
    "expose-loader": "^3.1.0",
    "glob": "11.0.0",
    "jsdom": "^26.1.0",
    "loadjs": "^4.3.0",
    "minimist": "^1.2.8",
    "mkdirp": "^3.0.1",
    "normalize.css": "^8.0.1",
    "postcss": "^8.5.3",
    "postcss-header": "^3.0.3",
    "postcss-import": "^16.1.0",
    "postcss-preset-env": "^10.1.6",
    "postcss-pxtorem": "^6.1.0",
    "postcss-url": "^10.1.3",
    "prettier": "^3.5.3",
    "shepherd.js": "~10.0.1",
    "sortablejs": "^1.15.6",
    "stylelint": "^16.19.1",
    "stylelint-checkstyle-formatter": "^0.1.2",
    "stylelint-config-standard": "^38.0.0",
    "stylelint-order": "^7.0.0",
    "tabbable": "^6.2.0",
    "terser": "^5.39.0",
    "terser-webpack-plugin": "^5.3.14",
    "underscore": "~1.13.7",
