<?php

/**
 * @file
 * The varbase_heroslider_media.module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\views\ViewExecutable;
use Drupal\varbase_heroslider_media\Hook\VarbaseHerosliderMediaHooks;

/**
 * Implements hook_views_pre_render().
 */
#[LegacyHook]
function varbase_heroslider_media_views_pre_render(ViewExecutable $view) {
  \Drupal::service(VarbaseHerosliderMediaHooks::class)->viewsPreRender($view);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function varbase_heroslider_media_theme($existing, $type, $theme, $path) {
  return \Drupal::service(VarbaseHerosliderMediaHooks::class)->theme($existing, $type, $theme, $path);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[LegacyHook]
function varbase_heroslider_media_preprocess_media_oembed_iframe__remote_video__varbase_media_hero_slider(&$variables) {
  \Drupal::service(VarbaseHerosliderMediaHooks::class)->preprocessMediaOembedIframe($variables);
}

/**
 * Implements hook_preprocess_HOOK().
 */
#[LegacyHook]
function varbase_heroslider_media_preprocess_node__varbase_heroslider_media(&$variables) {
  \Drupal::service(VarbaseHerosliderMediaHooks::class)->preprocessNode($variables);
}
